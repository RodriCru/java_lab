# Variables publicas del frontend. Copia este archivo como .env.local
#
# URL base de la API del backend. Si no se define, el cliente usa
# http://localhost:8080/api/v1 por defecto.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# --- Produccion (Vercel) ---
# En Vercel el navegador solo habla con el propio sitio y Next reenvia /api/v1/* al backend:
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
#   BACKEND_URL=https://tu-api.onrender.com     (sin NEXT_PUBLIC_: no se expone al navegador)
# Defínelas ANTES del primer build: NEXT_PUBLIC_* se incrusta al compilar.
