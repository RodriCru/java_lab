# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- Backend ---
# OBLIGATORIO. Clave para firmar los JWT: aleatoria y de al menos 32 caracteres. Sin ella el backend no arranca.
# Generala con:  openssl rand -base64 48
JAVALAB_JWT_SECRET=
# Minutos que dura la sesion.
JAVALAB_JWT_EXPIRATION_MINUTES=1440
# true en produccion: la cookie de sesion solo viaja por HTTPS.
JAVALAB_COOKIE_SECURE=false
# Origenes del frontend autorizados, separados por coma.
JAVALAB_ALLOWED_ORIGINS=http://localhost:3000

# --- Correo (Resend): codigos OTP y bienvenida ---
# API key de Resend (https://resend.com/api-keys, permiso "Sending access" limitado al dominio).
# Si queda vacia NO se envia nada: el correo y su codigo salen en el log del backend.
JAVALAB_RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend.
JAVALAB_MAIL_FROM=Java Lab <no-reply@mail.luisrodrigoch.lat>

# false cierra el registro de cuentas nuevas (el login de las existentes sigue funcionando).
# En produccion (perfil prod) el valor por defecto es false: las cuentas se crean por invitacion desde /admin.
JAVALAB_REGISTRATION_ENABLED=true
# Cuenta que se promueve a SUPER_ADMIN al arrancar (debe existir). Opcional.
# JAVALAB_SUPER_ADMIN_EMAIL=tu-correo@ejemplo.com

# --- Produccion (Render): Postgres en vez de SQLite ---
# Solo se usan con SPRING_PROFILES_ACTIVE=prod (el Dockerfile ya lo fija). En local dejalas comentadas.
# JAVALAB_DB_URL=jdbc:postgresql://<host-de-neon>/<base>?sslmode=require
# JAVALAB_DB_USER=
# JAVALAB_DB_PASSWORD=

# Ruta al archivo SQLite local.
JAVALAB_DB_PATH=./data/javalab.db

# Directorio donde vive el catalogo de ejercicios (YAML).
JAVALAB_EXERCISES_DIR=../exercises

# --- Runner de ejecucion ---
# Imagen Docker que compila y ejecuta el codigo del alumno.
JAVALAB_RUNNER_IMAGE=javalab-runner:17
# Si es false, se usa el fallback con JavaCompiler en proceso aislado.
JAVALAB_RUNNER_USE_DOCKER=true
# Limites de recursos del contenedor.
JAVALAB_RUNNER_TIMEOUT_SECONDS=10
JAVALAB_RUNNER_MEMORY=256m
JAVALAB_RUNNER_CPUS=0.5

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
